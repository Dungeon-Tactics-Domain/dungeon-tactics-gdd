target/
web/node_modules/
web/dist/
*.log
*.pid
.env*

# Real session ids of the developer; copy config/fabrica.example.toml to config/fabrica.toml
config/fabrica.toml

# Fernando's per-asset decisions, written by the server; data/decisoes.example.json shows the format
/data/*
!/data/decisoes.example.json

# Generated captures and audio (the app icon and favicon are the only images kept)
*.png
*.webp
*.ogg
*.mp3
*.wav
!web/public/favicon.*
!web/public/icon*.*
_notas/
*.gif

# Vagrant Story sounds, music and the game build with VS models: copied from D:\Projetos\_estudo-vagrant and served
# on the lab domain only through the build (decided 17/11); never in git
web/public/content/vagrant/sfx/
web/public/content/vagrant/musica/
web/public/content/vagrant/jogo/

# SoundFonts for the live synthesizer: large, with their own licences, kept on the developer machine only
web/public/soundfonts/
