{
  "name": "dungeon-tactics-labs-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:watch": "vite build --watch --no-emptyOutDir",
    "preview": "vite preview",
    "typecheck": "tsc -b",
